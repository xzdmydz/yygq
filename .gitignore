*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
unity.vscode*.json
*.unityproj

# Unity 崩溃报告
sysinfo.txt

# 构建产物
*.apk
*.aab
*.unitypackage
*.app
